# WFC Quality Targets (generated by wfc-init)
.PHONY: quality-check format lint test

quality-check: format lint
	@echo "All quality checks passed"

format:
	@echo "Formatting Python..."
	@if command -v black >/dev/null 2>&1; then \
		find ./core -name "*.py" \
			-not -path "*/.venv-docker/*" \
			-not -path "*/__pycache__/*" \
			-not -path "*/migrations/*" \
			-not -path "*/static/*" \
			| xargs black; \
	fi
	@echo "Formatting JavaScript..."
	@if command -v prettier >/dev/null 2>&1; then \
		find ./core/js -name "*.js" \
			-not -path "*/node_modules/*" \
			| xargs prettier --write; \
	fi
	@echo "Formatting complete"

lint:
	@echo "Linting Python..."
	@if command -v ruff >/dev/null 2>&1; then \
		ruff check ./core --exclude ./core/.venv-docker --exclude "*/migrations/*"; \
	fi
	@echo "Linting JavaScript..."
	@if command -v eslint >/dev/null 2>&1; then \
		eslint ./core/js --ext .js --ignore-path ./core/js/.eslintignore; \
	fi
	@echo "Linting complete"

test:
	@echo "Running Python tests..."
	docker-compose run --rm django pytest core/ -x
